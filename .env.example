# Application
API_ENDPOINT=https://api.example.com
SECRET_KEY=your_secret_key
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=True

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/carai
MAX_CONNECTIONS=100

# Supabase
SUPABASE_PROJECT_ID=local-project
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_PASSWORD=local-password
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@carai.com
EMAILS_FROM_NAME=Carai Receptionist

# Notifications / Messaging
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=
PUSH_PROVIDER=disabled

# Observability
SENTRY_DSN=
SENTRY_ENV=development
